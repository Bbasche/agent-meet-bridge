# Optional defaults. Every value can also be passed as a CLI flag.
MEETING_AGENT_NAME=Agent
# Optional operator-supplied persona or role guidance for the connected agent.
MEETING_AGENT_INSTRUCTIONS=
MEETING_AGENT_MODE=passive
MEETING_AGENT_RUNTIME=local
# Engineering harness: codex, claude, hermes, pi, or generic.
MEETING_AGENT_HARNESS=codex
MEETING_AGENT_HARNESS_CONTEXT_ID=
MEETING_AGENT_HARNESS_MODEL=
MEETING_AGENT_HERMES_PROVIDER=
MEETING_AGENT_HARNESS_COMMAND=
MEETING_AGENT_HARNESS_OUTPUT=text
MEETING_AGENT_TRANSCRIPT_SOURCE=meet-captions
MEETING_AGENT_VOICE=en-GB
MEETING_AGENT_REALTIME_REASONING_EFFORT=
MEETING_AGENT_BROWSER_CHANNEL=chrome
MEETING_AGENT_VAD_THRESHOLD=420
MEETING_AGENT_ALONE_TIMEOUT_MINUTES=5
# Optional vocabulary hints for names, products, and technical terms in this call.
MEETING_AGENT_WHISPER_PROMPT=
MEETING_AGENT_AGENDA=
WHISPER_MODEL_PATH=
# Keep this separate from your personal Chrome profile. Sign a dedicated Google
# account into it once if the Workspace meetings you join reject anonymous guests.
MEETING_AGENT_PROFILE_DIR=
# Leave blank to create a dedicated persistent Codex task owned by the meeting
# agent. Resuming a task that is currently open in Codex can hit an active-writer lock.
MEETING_AGENT_CODEX_THREAD_ID=
MEETING_AGENT_WORKSPACE=
# Backwards-compatible workspace variable.
CODEX_WORKSPACE=

# Public realtime providers. Set only the key for the selected runtime.
OPENAI_API_KEY=
XAI_API_KEY=
MEETING_AGENT_MODEL=
